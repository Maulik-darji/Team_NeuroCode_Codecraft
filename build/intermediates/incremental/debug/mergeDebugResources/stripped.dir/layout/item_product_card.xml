<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="140dp"
    android:layout_height="220dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_product_card"
    android:clipToPadding="false"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/bg_product_card"
            android:backgroundTint="@color/product_img_bg">
            <TextView
                android:id="@+id/tv_category_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="8dp"
                android:text="Study table"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold" />
                
            <ImageView
                android:id="@+id/iv_heart"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:src="@drawable/ic_heart_outline"
                app:tint="@color/text_secondary" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@android:color/transparent">
            
            <TextView
                android:id="@+id/tv_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="₹2,400"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />
                
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="Wooden study table with drawer"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2" />
                
            <TextView
                android:id="@+id/tv_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Piplod · 3 km"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
