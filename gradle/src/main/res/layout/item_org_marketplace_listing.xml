<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_org_card"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- PHOTO PLACEHOLDER CONTAINER (100dp wide) -->
    <RelativeLayout
        android:id="@+id/containerPhotoPlaceholder"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="#2E4A3E">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="PHOTO"
            android:textColor="#A0C4B8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlaceholderCategoryTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="14dp"
            android:paddingHorizontal="4dp"
            android:text="RING FRAME"
            android:textColor="@color/org_surface_white"
            android:textSize="10sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- CONTENT RIGHT -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvListingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/tvListingStatus"
                android:layout_alignParentStart="true"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Lakshmi Rieter G32 ring frame"
                android:textColor="@color/org_text_charcoal"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvListingStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_org_badge_normal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Available"
                android:textColor="@color/org_primary_forest"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvSellerInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Shreeji Spinning Mills • Surat"
            android:textColor="@color/org_text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹12,40,000"
                android:textColor="@color/org_primary_forest"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="· 2 available"
                android:textColor="@color/org_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMetadataText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Working · MOQ 1 · Pickup"
            android:textColor="@color/org_text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
