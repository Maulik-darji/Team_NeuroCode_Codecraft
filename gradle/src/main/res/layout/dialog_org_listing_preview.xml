<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/org_bg_warm"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@color/org_border_muted" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MARKETPLACE LISTING PREVIEW"
        android:textColor="@color/org_text_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- PREVIEW CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_org_card"
        android:orientation="vertical"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvPreviewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toStartOf="@id/tvPreviewIntentBadge"
                android:layout_alignParentStart="true"
                android:text="Lakshmi Rieter G32 ring frame"
                android:textColor="@color/org_text_charcoal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPreviewIntentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_org_badge_normal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="SELL"
                android:textColor="@color/org_primary_forest"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvPreviewSeller"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Shivalik Textiles • Pandesara Unit, Surat"
            android:textColor="@color/org_text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPreviewPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹12,40,000"
                android:textColor="@color/org_primary_forest"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPreviewQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="· 2 units available"
                android:textColor="@color/org_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPreviewMetadata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Working · MOQ 1 · Buyer pickup"
            android:textColor="@color/org_text_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPreviewDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Industrial ring frame machine in working condition. Recently refurbished. Available for immediate pickup."
            android:textColor="@color/org_text_charcoal"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnClosePreview"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_org_button_forest"
        android:text="Close preview"
        android:textColor="@color/org_surface_white"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
