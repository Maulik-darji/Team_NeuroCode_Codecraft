<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/success_bg">

    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_back"
        android:layout_marginTop="48dp"
        android:layout_marginStart="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/fl_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@color/green_primary"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        app:layout_constraintTop_toBottomOf="@id/iv_back"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_check_white"
            android:layout_gravity="center" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="Workspace ready,\nShivalik Textiles."
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:letterSpacing="-0.03"
        android:lineSpacingExtra="-4dp"
        app:layout_constraintTop_toBottomOf="@id/fl_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/border_color"
        android:layout_marginTop="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/ll_checklist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
            <FrameLayout android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_checkbox_checked" android:layout_gravity="center_vertical"><ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_check_white" android:layout_gravity="center"/></FrameLayout>
            <TextView android:id="@+id/tv_resources_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4 resources connected to meters" android:textColor="@color/black" android:layout_marginStart="12dp" />
        </LinearLayout>
        
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
            <FrameLayout android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_checkbox_checked" android:layout_gravity="center_vertical"><ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_check_white" android:layout_gravity="center"/></FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 branches added — Pandesara, Sachin, Kim" android:textColor="@color/black" android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
            <FrameLayout android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_checkbox_checked" android:layout_gravity="center_vertical"><ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_check_white" android:layout_gravity="center"/></FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rhea Patel set as workspace admin" android:textColor="@color/black" android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <FrameLayout android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_checkbox_checked" android:layout_gravity="center_vertical"><ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_check_white" android:layout_gravity="center"/></FrameLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bulk marketplace seller profile live" android:textColor="@color/black" android:layout_marginStart="12dp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_ai_box"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/ll_checklist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <View android:layout_width="4dp" android:layout_height="match_parent" android:background="@color/green_primary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RELOOP AI" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/green_primary" android:letterSpacing="0.1" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="I'll baseline your consumption from the last 3 months of meter data and flag anything heading past a threshold." android:textColor="@color/black" android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/btn_continue"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_btn_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Go to dashboard"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="16dp" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow_right"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="16dp" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
