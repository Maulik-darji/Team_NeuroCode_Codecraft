rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isOrgAdmin(orgId) {
      return isAuthenticated() && 
        (request.auth.token.role == 'org_admin' || request.auth.token.role == 'platform_admin') &&
        (request.auth.token.orgId == orgId || request.auth.token.role == 'platform_admin');
    }

    function isOrgMember(orgId) {
      return isAuthenticated() && 
        (request.auth.token.orgId == orgId || request.auth.token.role == 'platform_admin');
    }

    function isPlatformAdmin() {
      return isAuthenticated() && request.auth.token.role == 'platform_admin';
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isPlatformAdmin();
      allow delete: if isPlatformAdmin();
    }

    // Organizations collection
    match /organizations/{orgId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOrgAdmin(orgId) || isPlatformAdmin();

      // Subcollection: Resources (isolated per organization)
      match /resources/{resourceId} {
        allow read, write: if isOrgMember(orgId) || isPlatformAdmin();
        
        match /usageLogs/{logId} {
          allow read, write: if isOrgMember(orgId) || isPlatformAdmin();
        }
      }

      // Subcollection: Goals
      match /goals/{goalId} {
        allow read, write: if isOrgMember(orgId) || isPlatformAdmin();
      }

      // Subcollection: Alerts
      match /alerts/{alertId} {
        allow read, write: if isOrgMember(orgId) || isPlatformAdmin();
      }
    }

    // Public & Marketplace Listings
    match /listings/{listingId} {
      allow read: if true; // Public marketplace browsing
      allow create: if isAuthenticated() && request.resource.data.postedBy == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.postedBy == request.auth.uid || isPlatformAdmin());
    }

    // Requirements
    match /requirements/{requirementId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.postedBy == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.postedBy == request.auth.uid || isPlatformAdmin());
    }

    // Conversations
    match /conversations/{conversationId} {
      allow create: if isAuthenticated() && 
        (request.resource.data.buyerUid == request.auth.uid || request.resource.data.sellerUid == request.auth.uid);
      allow read, update, delete: if isAuthenticated() && 
        (resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid || isPlatformAdmin());

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // Recycle Requests
    match /recycleRequests/{requestId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isPlatformAdmin());
      allow create: if isAuthenticated();
      allow update: if isPlatformAdmin();
    }
  }
}
